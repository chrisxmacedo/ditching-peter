{
  "name": "Ditching Peter role library",
  "site": "https://ditchingpeter.com",
  "framework": "ARA",
  "ara": {
    "authority": "MAY and MAY NOT. What the role may decide, the limit, and who it escalates to.",
    "responsibility": "MUST. What the role delivers, to whom, and when.",
    "ability": "CAN. The skills, tools, and methods the role requires."
  },
  "note": "Money limits in the free specs are examples — set your own. This file includes the full spec for the nine free roles only. The eighteen paid roles are title, one line, and in_pack. Their specs are not published here.",
  "free_role_count": 9,
  "in_pack_count": 18,
  "roles": [
    {
      "title": "Sales Director",
      "in_pack": false,
      "url": "https://ditchingpeter.com/role-library#sales-director",
      "reports_to": "CEO",
      "authority": [
        {
          "keyword": "MAY",
          "clause": "Sign contracts",
          "limit": "up to £150,000",
          "else": "CEO",
          "note": "example — set yours"
        },
        {
          "keyword": "MAY",
          "clause": "Discount a sale",
          "limit": "up to 7% of value",
          "else": "CEO"
        },
        {
          "keyword": "MAY",
          "clause": "Commit the quarterly sales budget",
          "limit": "up to £50,000 / qtr",
          "else": "CEO",
          "note": "example — set yours"
        },
        {
          "keyword": "MAY",
          "clause": "Spend the discretionary fund",
          "limit": "up to £10,000 / yr",
          "else": "CEO",
          "note": "example — set yours"
        },
        {
          "keyword": "MAY",
          "clause": "Hire into the sales team",
          "limit": "within the headcount plan",
          "else": "CEO"
        }
      ],
      "responsibility": [
        {
          "keyword": "MUST",
          "clause": "Keep the approved product list current",
          "to": "Sales Executives",
          "when": "when it changes"
        },
        {
          "keyword": "MUST",
          "clause": "Set and allocate quarterly quotas",
          "to": "Sales Executives",
          "when": "each quarter"
        },
        {
          "keyword": "MUST",
          "clause": "Deliver the quarterly sales forecast",
          "to": "CEO",
          "when": "quarterly"
        },
        {
          "keyword": "MUST",
          "clause": "Deliver the pipeline report",
          "to": "CEO",
          "when": "weekly, Fri 17:00"
        }
      ],
      "ability": [
        {
          "keyword": "CAN",
          "clause": "Read and challenge pipeline data and forecasts in the CRM (e.g. Salesforce)"
        },
        {
          "keyword": "CAN",
          "clause": "Build reports & dashboards in Salesforce and Excel"
        }
      ]
    },
